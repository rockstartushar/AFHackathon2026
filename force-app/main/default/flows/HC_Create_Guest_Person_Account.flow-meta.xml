    <description>Creates or retrieves a Person Account for guest patient scheduling. Normalizes phone (aligned with HC_Resolve_Patient_By_Phone), dedupes by phone, loads Person Account record type before insert, returns Account Id and CREATED_NEW | MATCHED_EXISTING | FAILED. Optional input_MessagingSessionId: when set, sets MessagingSession.EndUserContactId via HC_MessagingSessionContactLink after MATCHED_EXISTING or CREATED_NEW.</description>
    <environments>Default</environments>
    <formulas>
        <name>Normalize_Phone_Formula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!PersonMobilePhone}, &apos; &apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;), &apos;(&apos;, &apos;&apos;), &apos;)&apos;, &apos;&apos;), &apos;+&apos;, &apos;&apos;), &apos;.&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>Has_Required_Guest_Fields</name>
        <dataType>Boolean</dataType>
        <expression>AND(LEN(TRIM({!patient_full_name})) &gt; 0, LEN(TRIM({!normalized_phone})) &gt; 0)</expression>
    </formulas>
    <formulas>
        <name>Guest_Create_Fault_Detail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Flow.FaultMessage}), &apos;An error occurred while processing the patient account request. Please try again or contact support.&apos;, LEFT({!$Flow.FaultMessage}, 500))</expression>
    </formulas>
    <formulas>
        <name>Extract_FirstName_Formula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!patient_full_name}, &apos; &apos;), LEFT({!patient_full_name}, FIND(&apos; &apos;, {!patient_full_name}) - 1), {!patient_full_name})</expression>
    </formulas>
    <formulas>
        <name>Extract_LastName_Formula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!patient_full_name}, &apos; &apos;), MID({!patient_full_name}, FIND(&apos; &apos;, {!patient_full_name}) + 1, LEN({!patient_full_name})), {!patient_full_name})</expression>
    </formulas>
    <formulas>
        <name>Has_Messaging_Session_Id</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!input_MessagingSessionId}))</expression>
    </formulas>
