    <description>Resolves Person Account by PersonMobilePhone (exact match after same normalization as HC_Create_Guest_Person_Account: strip spaces, dashes, parentheses). If multiple patients share the same phone, first returned row wins. Optional input_MessagingSessionId: when set (e.g. Enhanced Chat session Id), sets MessagingSession.EndUserContactId via HC_MessagingSessionContactLink after UNIQUE_MATCH.</description>
    <environments>Default</environments>
    <formulas>
        <name>Normalize_Phone_Formula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!input_Phone}, &apos; &apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;), &apos;(&apos;, &apos;&apos;), &apos;)&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>Has_Messaging_Session_Id</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!input_MessagingSessionId}))</expression>
    </formulas>
