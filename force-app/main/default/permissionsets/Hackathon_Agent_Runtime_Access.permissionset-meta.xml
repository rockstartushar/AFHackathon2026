<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Permission set for Einstein Service Agent runtime user to access flows, Apex, and Account operations for guest patient creation</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Hackathon Agent Runtime Access</label>
    
    <pageAccesses>
        <apexPage>HC_ApiSessionId</apexPage>
        <enabled>true</enabled>
    </pageAccesses>

    <!-- Flow Access -->
    <flowAccesses>
        <enabled>true</enabled>
        <flow>HC_Create_Guest_Person_Account</flow>
    </flowAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>HC_Resolve_Patient_By_Phone</flow>
    </flowAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>HC_Log_Agent_Action</flow>
    </flowAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>HC_Get_Facilities</flow>
    </flowAccesses>
    
    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>HC_SymptomRoutingInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_SlotSuggestionInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_BookingActionsInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_DirectoryInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_PatientDataActionsInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_ReminderInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HCAuditHelper</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HCFacilityListInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HCSymptomRoutingUiModel</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HCPatientVisitListInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HCPatientVisitListUiModel</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_SchedulingConsoleController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_MessagingSessionSummaryController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HC_MessagingSessionContactLink</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    
    <!-- Account: View All pairs with HealthcareFacility View All in this org -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    
    <!-- Contact Object Permissions -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    
    <!-- Omni / messaging handoff summary (MessagingEndUser required for MessagingSession read) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>MessagingEndUser</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>MessagingSession</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Conversation</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ConversationEntry</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ServiceAppointment for Booking -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ServiceAppointment</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    
    <!-- HealthcareFacility for Facility Lookup -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>HealthcareFacility</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    
    <!-- HealthcareProvider for Provider Lookup -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>HealthcareProvider</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    
    <!-- Custom Objects -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Agent_Action_Log__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Patient_Insurance__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Symptom_Specialty_Map__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>MessagingSession.EndUserContactId</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- User Permissions -->
    <userPermissions>
        <enabled>true</enabled>
        <name>RunFlow</name>
    </userPermissions>
</PermissionSet>